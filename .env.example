# Copy this file to .env for local development and fill in real values.
# .env is gitignored - never commit real secrets.
#
# On Cloud Run, these should be set as env vars (FLASK_SECRET_KEY should be
# backed by Secret Manager, the same way GROQ_API_KEY/gmail-token already
# are) - not by shipping a .env file in the image.

# --- Existing app config (unrelated to auth) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Auth: who is allowed to sign in ---
# Comma-separated, case-insensitive, whitespace around entries is trimmed.
ALLOWED_USERS=you@example.com,someone-else@example.com

# --- Auth: Flask session signing key ---
# Any long random string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
# If unset, a random per-process key is used - fine for local dev only, since
# it changes on every restart and differs across Cloud Run instances.
FLASK_SECRET_KEY=

# --- Auth: Firebase Web SDK config (NOT secret) ---
# Paste the exact object from Firebase Console -> Project settings ->
# "SDK setup and configuration" -> Config, as a single-line JSON string.
# Example:
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"school-assistant-499518.firebaseapp.com","projectId":"school-assistant-499518","appId":"..."}
FIREBASE_WEB_CONFIG=
